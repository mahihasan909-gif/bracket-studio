# ── Turso (libSQL) ──────────────────────────────────────────────────
# 1. Sign up free at https://turso.tech
# 2. Create a database: turso db create bracket-studio
# 3. Get the URL:   turso db show bracket-studio --url
# 4. Get the token: turso db tokens create bracket-studio
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# ── Dashboard ───────────────────────────────────────────────────────
# Choose a strong password for the /dashboard route
DASHBOARD_PASSWORD=choose-a-strong-password
